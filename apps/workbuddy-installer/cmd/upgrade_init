#!/bin/bash
# cmd/upgrade_init — 升级前钩子
# SPDX-License-Identifier: MIT
#
# fnOS 在“包升级”（而非全新安装）时会走 upgrade_* 而不是 install_*。
# 早期版本这里直接 exit 0，导致“升级安装器”永远不刷新 NAS 上的 start.sh，
# 启动方式的修复因此落不了地。
#
# install_init 本身是幂等的：是否下载 WorkBuddy 本体、是否需要刷新
# start.sh、是否需要重启服务，它都会自行判断。故直接复用。

CMD_DIR="$(cd "$(dirname "$0")" && pwd)"

exec "$CMD_DIR/install_init"
